# Runtime mode: demo, development, production
APP_ENV=demo

# Core application
DATABASE_URL=postgresql://swipe:swipe@localhost:5432/swipe_demo
ASYNC_DATABASE_URL=postgresql+asyncpg://swipe:swipe@localhost:5432/swipe_demo
SECRET_KEY=demo-secret-key-not-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_HOURS=168
MAX_DISTANCE=100
MAIN_APP_HOST=0.0.0.0
MAIN_APP_PORT=1024
MATCHES_APP_HOST=0.0.0.0
MATCHES_APP_PORT=1025

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Demo adapters
DEMO_VERIFICATION_CODE=000000
DEMO_STORAGE_DIR=.demo_storage

# Internal service URLs
API_URL=http://localhost:1024
SOCKET_URL=http://localhost:1025
PUSH_URL=http://localhost:1026/send_push

# DaData (required in production)
DADATA_API_TOKEN=
DADATA_API_SECRET=
DADATA_API_URL=

# Yandex Object Storage / S3 (required in production)
YANDEX_KEY_ID=
YANDEX_KEY=
BUCKET_MESSAGE_IMAGES=message-images
BUCKET_MESSAGE_VOICES=message-voices
BUCKET_PROFILE_IMAGES=profile-images
BUCKET_VERIFY_IMAGES=verify-images

# SMSC (required in production)
SMS_API_KEY=
SMS_CENTER_LOGIN=
SMS_CENTER_PASSWORD=
SMS_SENDER=

# Firebase Admin service account (required in production)
FIREBASE_CREDENTIALS_PATH=

# Telegram verification integration
BOT_SECRET_TOKEN=
VERIFY_CHAT_LINK=
VERIFY_CHAT_ID=
VERIFY_SEND_TEXT=

# Optional legacy OpenAI matching helper
OPEN_API_KEY=

# T-Bank acquiring (required in production)
TBANK_KASSA_PASSWORD=
TBANK_KASSA_TERMINAL=

# Alembic
ENV_FILE=.env
ENVIRONMENT=dev
ALEMBIC_DEV_URL=postgresql://swipe:swipe@localhost:5432/swipe_demo
ALEMBIC_PROD_URL=
